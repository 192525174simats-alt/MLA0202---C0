
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

ads = ["Ad A", "Ad B", "Ad C", "Ad D", "Ad E"]
true_ctr = np.array([0.04, 0.07, 0.05, 0.09, 0.06])
n_ads = len(ads)
total_users = 10000

counts = np.zeros(n_ads)
rewards = np.zeros(n_ads)
total_reward = 0
cumulative_rewards = []
regret = []

for user in range(1, total_users + 1):
    if user <= n_ads:
        selected = user - 1
    else:
        average_reward = rewards / np.maximum(counts, 1)
        confidence = np.sqrt(2 * np.log(user) / np.maximum(counts, 1))
        ucb = average_reward + confidence
        selected = np.argmax(ucb)

    click = np.random.rand() < true_ctr[selected]
    reward = int(click)

    counts[selected] += 1
    rewards[selected] += reward
    total_reward += reward

    best_possible = np.max(true_ctr) * user
    cumulative_rewards.append(total_reward)
    regret.append(best_possible - total_reward)

estimated_ctr = rewards / counts

print("Advertisement Performance")
print("-------------------------")

for i in range(n_ads):
    print(ads[i],
          "Displays:", int(counts[i]),
          "Clicks:", int(rewards[i]),
          "Estimated CTR:", round(estimated_ctr[i], 4))

print("\nTotal users:", total_users)
print("Total clicks:", int(total_reward))
print("Overall CTR:", round(total_reward / total_users, 4))
print("Best advertisement:", ads[np.argmax(estimated_ctr)])

plt.figure(figsize=(9, 5))
plt.bar(ads, estimated_ctr * 100)
plt.axhline(np.max(true_ctr) * 100, linestyle="--",
            label="Best true CTR")
plt.xlabel("Advertisement")
plt.ylabel("Click-Through Rate (%)")
plt.title("UCB Advertisement Selection Performance")
plt.legend()
plt.grid(axis="y", alpha=0.3)
plt.show()

plt.figure(figsize=(9, 5))
plt.plot(regret)
plt.xlabel("User Interaction")
plt.ylabel("Cumulative Regret")
plt.title("Cumulative Regret over 10,000 Interactions")
plt.grid(True)
plt.show()
