import matplotlib.pyplot as plt

fig, ax = plt.subplots(figsize=(10, 6))

nodes = {
    "Transaction Amount": (1, 4),
    "Transaction Location": (1, 3),
    "Login Device": (1, 2),
    "Previous Fraud History": (1, 1),
    "FRAUD": (4, 2.5)
}

for name, (x, y) in nodes.items():
    if name == "FRAUD":
        ax.text(x, y, name,
                ha="center", va="center",
                fontsize=14, fontweight="bold",
                bbox=dict(boxstyle="round,pad=0.7",
                          facecolor="red",
                          alpha=0.6))
    else:
        ax.text(x, y, name,
                ha="center", va="center",
                fontsize=11,
                bbox=dict(boxstyle="round,pad=0.6",
                          facecolor="lightblue",
                          edgecolor="black"))

for y in [4, 3, 2, 1]:
    ax.annotate("",
                xy=(3.55, 2.5),
                xytext=(1.65, y),
                arrowprops=dict(
                    arrowstyle="->",
                    linewidth=2
                ))

ax.text(2.2, 4.35, "Influences", fontsize=11)

ax.set_xlim(0, 5)
ax.set_ylim(0, 5)
ax.axis("off")

plt.title(
    "Bayesian Network – Credit Card Fraud Detection",
    fontsize=16,
    fontweight="bold"
)

plt.show()
