import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

number_of_trials = 10000
traffic_probability = 0.70

on_time_count = 0
late_count = 0

simulation_numbers = []
estimated_probabilities = []
on_time_deliveries = []
late_deliveries = []

for trial in range(1, number_of_trials + 1):

    traffic_condition = np.random.choice(
        ["Light", "Moderate", "Heavy"],
        p=[0.45, 0.35, 0.20]
    )

    if traffic_condition == "Light":
        delivery_probability = 0.90

    elif traffic_condition == "Moderate":
        delivery_probability = 0.70

    else:
        delivery_probability = 0.40

    delivery_result = np.random.rand()

    if delivery_result <= delivery_probability:
        on_time_count += 1
    else:
        late_count += 1

    current_probability = on_time_count / trial

    simulation_numbers.append(trial)
    estimated_probabilities.append(current_probability)
    on_time_deliveries.append(on_time_count)
    late_deliveries.append(late_count)

final_probability = on_time_count / number_of_trials

print("MONTE CARLO SAMPLING")
print("--------------------")
print("Total Simulations:", number_of_trials)
print("On-Time Deliveries:", on_time_count)
print("Late Deliveries:", late_count)
print("Estimated Probability of On-Time Delivery:",
      round(final_probability, 4))
print("Estimated Percentage:",
      round(final_probability * 100, 2), "%")

plt.figure(figsize=(10, 6))

plt.plot(
    simulation_numbers,
    estimated_probabilities,
    label="Estimated Probability"
)

plt.axhline(
    y=traffic_probability,
    linestyle="--",
    label="Reference Probability"
)

plt.xlabel("Number of Simulations")
plt.ylabel("Probability")
plt.title("Monte Carlo Estimation of On-Time Deliveries")
plt.legend()
plt.grid(True)
plt.show()

plt.figure(figsize=(10, 6))

plt.plot(
    simulation_numbers,
    on_time_deliveries,
    label="On-Time Deliveries"
)

plt.plot(
    simulation_numbers,
    late_deliveries,
    label="Late Deliveries"
)

plt.xlabel("Number of Simulations")
plt.ylabel("Number of Deliveries")
plt.title("Delivery Simulation Results")
plt.legend()
plt.grid(True)
plt.show()
