import numpy as np
import matplotlib.pyplot as plt

np.random.seed(25)

movies = [
    "Action",
    "Comedy",
    "Drama",
    "Sci-Fi",
    "Animation"
]

true_rewards = np.array([
    0.45,
    0.65,
    0.55,
    0.80,
    0.40
])

number_of_movies = len(movies)
number_of_interactions = 2000

epsilon = 0.10

reward_estimates = np.zeros(number_of_movies)
selection_count = np.zeros(number_of_movies)

total_rewards = 0

interaction_numbers = []
average_rewards = []
best_estimates = []

for interaction in range(1, number_of_interactions + 1):

    random_value = np.random.rand()

    if random_value < epsilon:
        selected_movie = np.random.randint(
            0,
            number_of_movies
        )

    else:
        selected_movie = np.argmax(
            reward_estimates
        )

    user_response = np.random.rand()

    if user_response < true_rewards[selected_movie]:
        reward = 1
    else:
        reward = 0

    selection_count[selected_movie] += 1

    old_estimate = reward_estimates[selected_movie]

    count = selection_count[selected_movie]

    reward_estimates[selected_movie] = (
        old_estimate +
        (reward - old_estimate) / count
    )

    total_rewards += reward

    average_reward = total_rewards / interaction

    interaction_numbers.append(interaction)
    average_rewards.append(average_reward)
    best_estimates.append(
        np.max(reward_estimates)
    )

best_movie_index = np.argmax(
    reward_estimates
)

print("EPSILON-GREEDY ALGORITHM")
print("------------------------")
print("Number of Movies:", number_of_movies)
print("User Interactions:", number_of_interactions)
print("Epsilon:", epsilon)
print()

print("Movie Reward Estimates")

for i in range(number_of_movies):

    print(
        movies[i],
        ":",
        round(reward_estimates[i], 4)
    )

print()

print("Movie Selection Counts")

for i in range(number_of_movies):

    print(
        movies[i],
        ":",
        int(selection_count[i])
    )

print()

print(
    "Best Movie:",
    movies[best_movie_index]
)

print(
    "Estimated Best Reward:",
    round(
        reward_estimates[best_movie_index],
        4
    )
)

print(
    "Overall Average Reward:",
    round(
        total_rewards / number_of_interactions,
        4
    )
)

plt.figure(figsize=(10, 6))

plt.plot(
    interaction_numbers,
    average_rewards,
    label="Average User Reward"
)

plt.xlabel("User Interactions")
plt.ylabel("Average Reward")
plt.title("Epsilon-Greedy Learning Performance")
plt.legend()
plt.grid(True)
plt.show()

plt.figure(figsize=(10, 6))

plt.bar(
    movies,
    reward_estimates
)

plt.xlabel("Movie Category")
plt.ylabel("Estimated Reward")
plt.title("Estimated Movie Engagement")
plt.grid(axis="y")
plt.show()

plt.figure(figsize=(10, 6))

plt.bar(
    movies,
    selection_count
)

plt.xlabel("Movie Category")
plt.ylabel("Number of Selections")
plt.title("Movie Recommendation Frequency")
plt.grid(axis="y")
plt.show()
