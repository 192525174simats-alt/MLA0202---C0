import numpy as np
import matplotlib.pyplot as plt

np.random.seed(50)

number_of_states = 6
number_of_episodes = 1000

alpha = 0.10
gamma = 0.90

state_values = np.zeros(
    number_of_states
)

episode_numbers = []
prediction_errors = []
average_values = []

for episode in range(
    1,
    number_of_episodes + 1
):

    current_state = 0
    episode_errors = []

    while current_state < number_of_states - 1:

        next_state = current_state + 1

        if next_state == number_of_states - 1:

            reward = 1

        else:

            reward = 0

        old_value = state_values[
            current_state
        ]

        next_value = state_values[
            next_state
        ]

        td_target = (
            reward
            + gamma * next_value
        )

        td_error = (
            td_target
            - old_value
        )

        state_values[
            current_state
        ] = (
            old_value
            + alpha * td_error
        )

        episode_errors.append(
            abs(td_error)
        )

        current_state = next_state

    episode_numbers.append(
        episode
    )

    prediction_errors.append(
        np.mean(episode_errors)
    )

    average_values.append(
        np.mean(state_values)
    )

print("TEMPORAL DIFFERENCE LEARNING")
print("-----------------------------")
print("Episodes:", number_of_episodes)
print("Learning Rate:", alpha)
print("Discount Factor:", gamma)
print()

print("Final State Values")

for state in range(
    number_of_states
):

    print(
        "State",
        state,
        ":",
        round(
            state_values[state],
            4
        )
    )

print()

print(
    "Final Average Prediction Error:",
    round(
        prediction_errors[-1],
        6
    )
)

plt.figure(figsize=(10, 6))

plt.plot(
    episode_numbers,
    prediction_errors
)

plt.xlabel("Episode")
plt.ylabel("Prediction Error")
plt.title(
    "Temporal Difference Learning Error"
)

plt.grid(True)
plt.show()

plt.figure(figsize=(10, 6))

plt.plot(
    range(number_of_states),
    state_values,
    marker="o"
)

plt.xlabel("Game State")
plt.ylabel("Estimated State Value")
plt.title(
    "Learned Value of Game States"
)

plt.grid(True)
plt.show()

plt.figure(figsize=(10, 6))

plt.plot(
    episode_numbers,
    average_values
)

plt.xlabel("Episode")
plt.ylabel("Average State Value")
plt.title(
    "State Value Learning Progress"
)

plt.grid(True)
plt.show()
