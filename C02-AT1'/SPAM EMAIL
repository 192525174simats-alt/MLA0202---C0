import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LogisticRegression

offer = np.array([3, 2, 1, 3, 0])
win = np.array([2, 1, 0, 3, 1])
spam = np.array([1, 1, 0, 1, 0])

X = np.column_stack((offer, win))

model = LogisticRegression(solver="liblinear")
model.fit(X, spam)

b0 = model.intercept_[0]
b1 = model.coef_[0][0]
b2 = model.coef_[0][1]

print("EMAIL SPAM CLASSIFICATION")
print("-------------------------")

print("\nClassification Coefficients")
print("Intercept =", b0)
print("Offer Coefficient =", b1)
print("Win Coefficient =", b2)

print("\nClassification Equation")
print("z =", b0, "+", b1, "* Offer +", b2, "* Win")

print("\nDecision Boundary")
print(b0, "+", b1, "* Offer +", b2, "* Win = 0")

new_email = np.array([[2, 1]])

probability = model.predict_proba(new_email)
prediction = model.predict(new_email)

print("\nNew Email")
print("Offer =", new_email[0][0])
print("Win =", new_email[0][1])

print("\nProbability of Not Spam =", probability[0][0])
print("Probability of Spam =", probability[0][1])

print("\nPredicted Class =", prediction[0])

if prediction[0] == 1:
    print("Result = Spam")
else:
    print("Result = Not Spam")

x = np.linspace(-0.5, 3.5, 100)
y = -(b0 + b1 * x) / b2

plt.scatter(offer[spam == 0], win[spam == 0], marker="o", s=100, label="Not Spam")
plt.scatter(offer[spam == 1], win[spam == 1], marker="o", s=100, label="Spam")

plt.plot(x, y, label="Decision Boundary")

plt.scatter(2, 1, marker="X", s=150, label="New Email")

plt.xlabel("Word Frequency (Offer)")
plt.ylabel("Word Frequency (Win)")
plt.title("Email Spam Classification")
plt.legend()
plt.grid(True)

plt.show()
